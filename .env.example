# FlakePilot reads these from the process environment; nothing loads this file.
# Names only. Empty means the default. Never put secret values here.

# Required. Shape: postgresql://USER:PASSWORD@HOST:5432/DBNAME
FLAKEPILOT_DATABASE_URL=
# CRITICAL, ERROR, WARNING, INFO (default) or DEBUG
FLAKEPILOT_LOG_LEVEL=
# IP address to bind (default 127.0.0.1)
FLAKEPILOT_HOST=
# Port to bind, 1-65535 (default 8000)
FLAKEPILOT_PORT=

# GitHub sign-in (ADR-009, ADR-011). Disabled (auth endpoints answer 503) unless all three are set.
# This deployment's origin, scheme://host[:port]; https unless insecure cookies are allowed.
FLAKEPILOT_PUBLIC_ORIGIN=
# The GitHub App's client ID and client secret.
FLAKEPILOT_GITHUB_CLIENT_ID=
FLAKEPILOT_GITHUB_CLIENT_SECRET=
# true only for local plain-HTTP development: drops Secure and the __Host- cookie prefix (default false)
# WARNING: never set this to true in production.
FLAKEPILOT_ALLOW_INSECURE_COOKIES=

# Encrypted secret store key: 32 random bytes, base64. Keep it outside the database and away
# from execution workers. Validated if set; nothing uses the secret store yet.
FLAKEPILOT_SECRET_KEY=
