# FlakePilot reads these from the process environment; nothing loads this file.
# Names only. Empty means the default. Never put secret values here.

# Required. Shape: postgresql://USER:PASSWORD@HOST:5432/DBNAME
FLAKEPILOT_DATABASE_URL=
# CRITICAL, ERROR, WARNING, INFO (default) or DEBUG
FLAKEPILOT_LOG_LEVEL=
# IP address to bind (default 127.0.0.1)
FLAKEPILOT_HOST=
# Port to bind, 1-65535 (default 8000)
FLAKEPILOT_PORT=

# GitHub sign-in (ADR-009, ADR-011). Disabled (auth endpoints answer 503) unless all three are set.
# This deployment's origin, scheme://host[:port]; https unless insecure cookies are allowed.
FLAKEPILOT_PUBLIC_ORIGIN=
# The GitHub App's client ID and client secret.
FLAKEPILOT_GITHUB_CLIENT_ID=
FLAKEPILOT_GITHUB_CLIENT_SECRET=
# true only for local plain-HTTP development: drops Secure and the __Host- cookie prefix (default false)
# WARNING: never set this to true in production.
FLAKEPILOT_ALLOW_INSECURE_COOKIES=

# Encrypted secret store key: 32 random bytes, base64. Keep it outside the database and away
# from execution workers. Validated if set; nothing uses the secret store yet.
FLAKEPILOT_SECRET_KEY=
# Artifact storage root for raw test reports: an existing absolute directory owned by the
# service user, not group- or world-writable, outside the repository.
# Unset: POST /ingest/junit answers 503 ingestion_not_configured.
FLAKEPILOT_ARTIFACT_DIR=

# Worker process only (`python -m flakepilot.interface.composition_root worker`). Empty means the default.
# Poll interval in seconds, 1-300 (default 2).
FLAKEPILOT_WORKER_POLL_SECONDS=
# Rows claimed per tick, 1-100 (default 10).
FLAKEPILOT_WORKER_BATCH_SIZE=
# Lease length in seconds, 5-3600 (default 30).
FLAKEPILOT_WORKER_LEASE_SECONDS=

# Execution. Default closed: the worker never starts a container. evaluation is an explicit
# opt-in and is not production isolation. It requires a digest-pinned image.
# closed (default) or evaluation.
FLAKEPILOT_EXECUTION_MODE=
# docker (default) or podman. Used only in evaluation mode.
FLAKEPILOT_EXECUTION_RUNTIME=
# Required for evaluation. Example: ghcr.io/example/reproduce@sha256:<64 hex>.
FLAKEPILOT_EXECUTION_IMAGE=
# Wall clock seconds, 5-120 (default 30). Memory MiB, 64-2048 (default 512). Pids, 8-256 (default 64).
FLAKEPILOT_EXECUTION_WALL_SECONDS=
FLAKEPILOT_EXECUTION_MEMORY_MB=
FLAKEPILOT_EXECUTION_PIDS=
# Optional GitHub contents token. Held in the code-host adapter only. Empty: revisions stay unverified.
FLAKEPILOT_GITHUB_CONTENTS_TOKEN=

# GitHub App installation identity for code-host access verification (ADR-016): the app id
# and an unencrypted RSA private key used only to mint a contents:read installation token for
# the verifier. Both required together; either alone is a startup error. Empty: the code-host
# access verifier can verify nothing and every session view answers 404 (fail closed — this
# is the safe default, e.g. this project's own demo).
FLAKEPILOT_GITHUB_APP_ID=
FLAKEPILOT_GITHUB_APP_PRIVATE_KEY=

# Advisory assist model (ADR-014, ADR-017): the full URL of an operator-run local
# inference endpoint (OpenAI-compatible chat completions, e.g. a self-hosted Gemma
# server) plus the model identifier recorded on every response. Both required together;
# either alone is a startup error. Empty: no model is contacted at all — assist stays
# disabled (NullAiAssist posture) until an org admin enables the policy. Advisory only:
# model output is evidence-linked claims, never authorization, verdicts, or execution.
FLAKEPILOT_AI_ENDPOINT=
FLAKEPILOT_AI_MODEL=
# Optional API key the adapter carries in the Authorization header for the local endpoint.
FLAKEPILOT_AI_API_KEY=

# Opt-in error reporting (sponsor goal 7): https://<public key>@<host>/<project id>.
# Empty: nothing is sent anywhere. Set: ERROR-level log records become allow-listed events
# (exception class, code locations, request id, route template; never messages' arguments,
# exception text, requests, headers, cookies or bodies).
FLAKEPILOT_SENTRY_DSN=

# Auth0 agent-token issuer (sponsor goal 9): the tenant host (e.g. tenant.auth0.com, no
# scheme) and the API identifier tokens must name in `aud`. Both or neither. Empty: no
# issuer token is honored. A verified token only narrows a delegated agent's scope.
# Set: POST /agent/orgs/{org}/runs/{run}/investigation exists and needs a token whose
# subject an org admin bound with `bind-agent`. Unset: that route does not exist.
FLAKEPILOT_AUTH0_DOMAIN=
FLAKEPILOT_AUTH0_AUDIENCE=

# Hosted providers (ADR-017). API process and operator commands only; never give them to
# the worker. Each is off, with no network contact, unless its key is set; a pair with one
# half set is a startup error. None has been verified against the live service.
#
# Hosted Gemma through the Gemini API (generativelanguage.googleapis.com): key plus model
# (gemma-4-31b-it or gemma-4-26b-a4b-it). Mutually exclusive with FLAKEPILOT_AI_ENDPOINT.
# Owner decision first: Gemma on the Gemini API is free-tier only, and Google may use
# free-tier prompts to improve its products. The org AI policy gate still applies.
FLAKEPILOT_GEMINI_API_KEY=
FLAKEPILOT_GEMINI_MODEL=
# SerpApi research (Google Search). The investigation's search query is the names of the
# run's failing tests; they leave the process to SerpApi.
FLAKEPILOT_SERPAPI_API_KEY=
# Browserbase Fetch: key plus a comma-separated exact-host allowlist of public lowercase host
# names (e.g. docs.python.org,github.com). Only research sources on the list are fetched;
# page text is hashed evidence and never reaches the model.
FLAKEPILOT_BROWSERBASE_API_KEY=
FLAKEPILOT_BROWSER_ALLOWLIST=
# ElevenLabs text to speech for the explicitly requested spoken brief (counts only, no
# repository text): key plus voice ID; model eleven_flash_v2_5 (default) or
# eleven_multilingual_v2.
FLAKEPILOT_ELEVENLABS_API_KEY=
FLAKEPILOT_ELEVENLABS_VOICE_ID=
FLAKEPILOT_ELEVENLABS_MODEL=
# Prior Labs TabPFN, used only by the evaluate-prioritization operator command. Sends numeric
# feature rows and 0/1 labels, nothing else.
FLAKEPILOT_TABPFN_API_KEY=
